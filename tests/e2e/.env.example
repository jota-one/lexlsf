# Astro SSR app (test port, kept away from a dev server on 4321)
BASE_URL=http://localhost:4330

# PocketBase instance (matches .env.local — start it with `pnpm db`)
PB_URL=http://127.0.0.1:8090

# Admin test account. Provisioned automatically on first run if missing,
# so these usually don't need to be changed.
TEST_ADMIN_EMAIL=e2e-admin@test.local
TEST_ADMIN_PASSWORD=e2e-password-123
